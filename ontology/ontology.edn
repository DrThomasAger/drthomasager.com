 :facets
 {:format {:definition "What kind of piece the post is."
           :values {:trial "A measured comparison with hypotheses written first."
                    :research "Original findings from data or a system built for it."
                    :essay "An argued view."
                    :definition "A precise answer to what a thing is."
                    :tutorial "Steps a reader follows to build or do something."
                    :tool "A working thing the reader uses on the page."
                    :prompt "A whole prompt given to use."
                    :translation "A text carried into English."
                    :memoir "Lived experience told."
                    :commentary "A reading of a text or teaching."}}
  :model {:definition "Every model the post runs or measures."
          :values {:humanlike-27b "Qwen3.8 27B Humanlike Chat."
                   :swift-27b "Swift Qwen3.8 27B Uncensored."
                   :fable "Claude Fable."
                   :opus "Claude Opus."
                   :glimmer-30b "Muse Glimmer 30B."}}
  :tool {:definition "Languages, libraries and programs the post builds with."
         :values {:babashka "Babashka." :clojure "Clojure." :d3 "D3." :paper-js "Paper.js."
                  :llama-cpp "llama.cpp and llama-server." :playwright "Playwright."
                  :runelite "RuneLite." :claude-code "Claude Code." :edge-tts "edge-tts."}}
  :method {:definition "How the post finds what it finds."
           :values {:with-and-without-prompt "The same model run with a prompt and without it."
                    :hypotheses-first "Hypotheses written before any run."
                    :program-measured "Measures computed by program, never by a model."
                    :engine-tokenizer "Tokens counted by the engine that reads them."
                    :simulation "Futures rolled forward from recorded states."
                    :a-b-drawing "A diagram drawn with and without an instruction and measured."}}
  :project {:definition "His named bodies of work the post belongs to or uses."
            :values {:smile "Smile." :ganapati "Ganapati." :ai-friends "AI Friends."
                     :low-contact-louie "Low-contact Louie." :tension-points "Tension Points."
                     :prompt-plateaus "Prompt Plateaus."}}
  :practice {:definition "The practice a Buddhism post concerns, or an AI post draws on."
             :values {:insight-contemplation "Insight contemplation." :ordination "Ordination."
                      :vow "The bodhisattva vow." :translation "Translation." :sacred-architecture "Sacred architecture."}}
  :level {:definition "Who the post is written for."
          :values {:beginner "Someone meeting the subject for the first time."
                   :practitioner "Someone already doing it."
                   :engineer "Someone who will run the code and read the numbers."}}
  :evidence {:definition "How what the post says is backed."
             :values {:measured "Numbers from runs, with the data published."
                      :built "A working system the reader can run."
                      :experienced "Lived and told."
                      :argued "Reasoned from what is known."}}}

 :sort {:date "Newest first by default."
        :evidence "Measured, then built, then experienced, then argued."
        :read-time "Shortest first."
        :depth "The most specific place first, for a search that names a subject."}}
